# Local .terraform directories in any subdirectory
**/.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Crash log files
crash.log

# Exclude override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Exclude plan files
*.tfplan
*.tfplan.*

# Sensitive variable files
*.tfvars
*.tfvars.json

# Include .terraform.lock.hcl (for Terraform 0.14+)
.terraform.lock.hcl

# Ignore IDE and OS-specific files
